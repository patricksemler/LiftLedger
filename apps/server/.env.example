# Copy to apps/server/.env.local. Local values match `supabase start` for this repo.
PORT=8790
PUBLIC_BASE_URL=http://localhost:8790
WEB_ORIGIN=http://localhost:5180
SUPABASE_URL=http://127.0.0.1:55421
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY from `supabase status`>
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres
# openssl rand -base64 32 — losing it makes stored API keys unreadable
LIFTLEDGER_ENCRYPTION_KEY=
# Telegram (optional): create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MODE=polling
TELEGRAM_WEBHOOK_SECRET=
# https://fdc.nal.usda.gov/api-key-signup/ — DEMO_KEY works for light use
USDA_FDC_API_KEY=DEMO_KEY
ALLOW_PRIVATE_AI_URLS=true
